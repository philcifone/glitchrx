{
  "productName": "glitchrx",
  "mainBinaryName": "glitchrx-desktop",
  "version": "0.2.0",
  "identifier": "org.glitcharaxia.glitchrx",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Graphics",
    "shortDescription": "Databend photos the way Audacity would",
    "longDescription": "Bends the raw pixels of a photo with audio effects (echo, reverb, phaser and more), the way importing it into Audacity as raw data would, and saves a normal image.",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "glrx"
        ],
        "name": "glitcharaxia project",
        "description": "glitcharaxia project: a photo and the steps that bend it",
        "mimeType": "application/vnd.glitcharaxia.project",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/org.glitcharaxia.glitchrx.xml": "mime/org.glitcharaxia.glitchrx.xml"
        }
      }
    }
  }
}
